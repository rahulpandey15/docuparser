# ---- Embeddings: huggingface | openai ----
DOCUPARSER_EMBEDDING_PROVIDER=huggingface
DOCUPARSER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BGE models work best with this prefix on queries (leave empty for OpenAI / other models)
DOCUPARSER_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
DOCUPARSER_EMBEDDING_DEVICE=cpu

# ---- LLM: openai (any OpenAI-compatible server, incl. Ollama/vLLM) | huggingface | none ----
DOCUPARSER_LLM_PROVIDER=openai
DOCUPARSER_LLM_MODEL=gpt-4o-mini
# For Ollama: DOCUPARSER_OPENAI_BASE_URL=http://localhost:11434/v1  DOCUPARSER_LLM_MODEL=llama3.1  DOCUPARSER_OPENAI_API_KEY=ollama
DOCUPARSER_OPENAI_API_KEY=
DOCUPARSER_OPENAI_BASE_URL=

# ---- Images inside PDFs: none | ocr | caption | both ----
DOCUPARSER_IMAGE_MODE=caption
# huggingface (BLIP, local) | openai (vision model)
DOCUPARSER_CAPTION_PROVIDER=huggingface
DOCUPARSER_CAPTION_MODEL=Salesforce/blip-image-captioning-base
DOCUPARSER_VISION_MODEL=gpt-4o-mini

# ---- Chroma: persistent (local dir) | http (server) ----
DOCUPARSER_CHROMA_MODE=persistent
DOCUPARSER_CHROMA_HOST=localhost
DOCUPARSER_CHROMA_PORT=8001

# ---- Retrieval / chunking ----
DOCUPARSER_CHUNK_SIZE=800
DOCUPARSER_CHUNK_OVERLAP=120
DOCUPARSER_TOP_K=5
